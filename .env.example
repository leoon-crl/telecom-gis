# ─────────────────────────────────────────────────────────────
# ART TELECOM GIS — Exemple de configuration
# Copier ce fichier vers « .env » (backend/) et adapter les valeurs.
# Ne JAMAIS committer le fichier .env réel.
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL + PostGIS
# En local  : postgresql+psycopg2://telecom:telecom2026@localhost:5432/telecom_gis
# En Docker : postgresql+psycopg2://telecom:telecom2026@base_de_donnees:5432/telecom_gis
DATABASE_URL=postgresql+psycopg2://telecom:telecom2026@localhost:5432/telecom_gis

# Sécurité JWT — GÉNÉRER une clé unique en production :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGEZ-MOI-cle-secrete-jwt-a-definir-dans-le-fichier-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Port d'écoute du backend
PORT=8000

# Mot de passe PostgreSQL utilisé par docker-compose
POSTGRES_PASSWORD=telecom2026
